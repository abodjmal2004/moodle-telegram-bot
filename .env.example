# ===== إعدادات أساسية (إجباري) =====
# التوكن من @BotFather
BOT_TOKEN=8755421426:AAFrk9HTSNm505Pq4y403AjQfv56oV4bnXw

# معرّفات تليجرام للمديرين (فاصلة بيناتهم) — بدونهم ما بتشوف /stats وغيرها
ADMIN_IDS=

# مفتاح التشفير (32 بايت، بصيغة hex) — ولّده مرة وحدة وثبّته:
# openssl rand -hex 32
ENCRYPTION_KEY=

# ===== قاعدة البيانات =====
# SQLite (الافتراضي): sqlite:///bot.db
# أو Postgres/MySQL للإنتاج: postgresql://user:pass@host/db
DATABASE_URL=sqlite:///bot.db

# ===== ميزات اختيارية (1 = مفعل، 0 = معطّل) =====
# التحكم بميزات البوت بدون ما تلمس الكود — عطّل أي شغلة بـ 0
FEATURES_RATE_LIMIT=1
FEATURES_ADMIN_PANEL=1
FEATURES_NOTIFICATIONS=1
FEATURES_EMAIL=1
FEATURES_PER_COURSE_NOTIF=1
FEATURES_AUTO_RELOGIN=1

# ===== لوحة الأدمن =====
ADMIN_PANEL_PORT=5000
ADMIN_PANEL_SECRET=change-me-in-production

# ===== الإيميل (إشعارات SMTP عبر Gmail) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SoNs Bot

# ===== الإشعارات الدورية =====
# كل كم دقيقة البوت بيفحص واجبات/إعلانات جديدة (20 افتراضي)
NOTIFICATION_CHECK_INTERVAL_MINUTES=20
# أقصى عدد جلسات Moodle متوازية أثناء الفحص (3 افتراضي)
NOTIFICATION_CONCURRENCY=3
